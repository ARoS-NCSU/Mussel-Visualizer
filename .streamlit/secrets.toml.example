# Copy to .streamlit/secrets.toml (git-ignored) and fill in.
# On Streamlit Community Cloud, paste this into the app's Settings -> Secrets.

[zooniverse_oauth]
client_id = "YOUR-ZOONIVERSE-APPLICATION-ID"
client_secret = "YOUR-ZOONIVERSE-APPLICATION-SECRET"
# Must match a Redirect URI of the Zooniverse OAuth application exactly.
# Locally: "http://localhost:8501"
redirect_uri = "https://mussel-visualizer-9kryg2pki7uvjswey3qzqu.streamlit.app/"

[zooniverse]
project_id = 31635
workflow_id = 31559
# project_slug = "coopsciscoop/bionic-mussels"  # optional, used for Talk links
